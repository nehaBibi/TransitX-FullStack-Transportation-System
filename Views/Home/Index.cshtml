@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section id="home" class="hero relative w-full h-screen flex items-center justify-center overflow-hidden pt-20">
    <div class="video-carousel-wrapper absolute inset-0 w-full h-full">
        <video id="heroVideo"
               class="absolute inset-0 w-full h-full object-cover"
               autoplay muted loop playsinline
               aria-label="Hero section background video">
            <source src="~/videos/Vid.mp4" type="video/mp4" />
            Your browser does not support the video tag.
        </video>
        <div class="absolute inset-0 bg-gradient-to-b from-cyan-600/10 via-transparent to-transparent"></div>
        <div class="absolute inset-0 opacity-30">
            <div class="absolute top-20 left-10 w-96 h-96 bg-cyan-500 rounded-full mix-blend-multiply filter blur-3xl"></div>
            <div class="absolute bottom-10 right-10 w-80 h-80 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl"></div>
        </div>
        <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <div class="hero-content relative z-10 text-center max-w-4xl mx-auto px-6 smooth-transition">
        <h1 class="text-6xl md:text-7xl font-bold mb-6 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">
            Smart Transit For Smart Cities
        </h1>
        <p class="text-xl md:text-2xl text-slate-300 mb-10 leading-relaxed">
            Real-time transportation tracking, smart scheduling, secure travel and modern user experience.
        </p>
        <div class="hero-buttons flex flex-col md:flex-row gap-6 justify-center">
            <a href="#routes" class="explore-btn px-8 py-4 bg-cyan-500 hover:bg-cyan-600 text-white font-semibold rounded-lg glow-hover smooth-transition">
                <i class="fa-solid fa-map mr-2"></i>Explore Routes
            </a>
            <a href="#tracking" class="px-8 py-4 bg-slate-700/50 hover:bg-slate-600 text-cyan-300 font-semibold rounded-lg border border-cyan-500/30 glow-hover smooth-transition">
                <i class="fa-solid fa-location-dot mr-2"></i>Live Tracking
            </a>
            <a href="#booking-tracker" class="px-8 py-4 bg-slate-700/50 hover:bg-slate-600 text-cyan-300 font-semibold rounded-lg border border-cyan-500/30 glow-hover smooth-transition">
                <i class="fa-solid fa-ticket mr-2"></i>My Bookings
            </a>
        </div>
    </div>

    <div class="video-controls absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 flex items-center gap-4">
        <button id="playPauseBtn" class="play-pause-btn p-3 rounded-full bg-cyan-500/80 hover:bg-cyan-600 text-white transition-all duration-300">
            <i class="fa-solid fa-pause"></i>
        </button>
        <div class="text-sm text-slate-300">
            <span id="videoTimer">0:00</span> / <span id="videoDuration">0:00</span>
        </div>
    </div>
</section>

<!-- Features -->
<section class="features py-20 px-8 max-w-7xl mx-auto">
    <div class="section-title text-center mb-16">
        <h2 class="text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">Why Choose TransitX?</h2>
        <p class="text-xl text-slate-400">Modern features for smart transportation systems.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="feature-card p-8 rounded-xl bg-gradient-to-br from-slate-800/50 to-slate-900/50 border border-slate-700/50 smooth-transition glow-hover hover:border-cyan-500/30">
            <div class="text-5xl mb-4 text-cyan-400"><i class="fa-solid fa-location-dot"></i></div>
            <h3 class="text-2xl font-bold mb-3 text-white">Live Tracking</h3>
            <p class="text-slate-400">Track transport routes and vehicles in real-time with precision updates.</p>
        </div>
        <div class="feature-card p-8 rounded-xl bg-gradient-to-br from-slate-800/50 to-slate-900/50 border border-slate-700/50 smooth-transition glow-hover hover:border-cyan-500/30">
            <div class="text-5xl mb-4 text-cyan-400"><i class="fa-solid fa-calendar-check"></i></div>
            <h3 class="text-2xl font-bold mb-3 text-white">Smart Scheduling</h3>
            <p class="text-slate-400">Get route timings and delay notifications instantly to plan ahead.</p>
        </div>
        <div class="feature-card p-8 rounded-xl bg-gradient-to-br from-slate-800/50 to-slate-900/50 border border-slate-700/50 smooth-transition glow-hover hover:border-cyan-500/30">
            <div class="text-5xl mb-4 text-cyan-400"><i class="fa-solid fa-shield"></i></div>
            <h3 class="text-2xl font-bold mb-3 text-white">Safe Travel</h3>
            <p class="text-slate-400">Secure and smooth transportation experience with verified operators.</p>
        </div>
    </div>
</section>

<!-- About -->
<section class="about py-20 px-8 bg-gradient-to-r from-slate-900/50 to-slate-800/50">
    <div class="max-w-4xl mx-auto">
        <div class="section-title text-center mb-12">
            <h2 class="text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">About TransitX</h2>
            <p class="text-slate-400">Revolutionizing urban and inter-city transportation</p>
        </div>
        <div class="about-content space-y-6 text-slate-300 leading-relaxed">
            <p class="text-lg">TransitX is a modern transportation platform providing route planning, live tracking, and schedule management for urban and inter-city travel.</p>
            <p class="text-lg">Founded in 2023, TransitX partners with local operators to deliver accurate arrival times, route maps, and timely updates.</p>
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="how py-20 px-8 max-w-7xl mx-auto">
    <div class="section-title text-center mb-16">
        <h2 class="text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">How It Works</h2>
        <p class="text-xl text-slate-400">Three simple steps to get moving with TransitX</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="feature-card p-8 rounded-xl bg-gradient-to-br from-slate-800/50 to-slate-900/50 border border-slate-700/50 smooth-transition glow-hover hover:border-cyan-500/30 text-center">
            <div class="text-5xl mb-4 text-cyan-400 flex justify-center"><i class="fa-solid fa-compass"></i></div>
            <h3 class="text-2xl font-bold mb-3 text-white">Search a Route</h3>
            <p class="text-slate-400">Find your desired origin and destination using the search box or browse popular routes.</p>
        </div>
        <div class="feature-card p-8 rounded-xl bg-gradient-to-br from-slate-800/50 to-slate-900/50 border border-slate-700/50 smooth-transition glow-hover hover:border-cyan-500/30 text-center">
            <div class="text-5xl mb-4 text-cyan-400 flex justify-center"><i class="fa-solid fa-clock"></i></div>
            <h3 class="text-2xl font-bold mb-3 text-white">Check Schedules</h3>
            <p class="text-slate-400">View departure times, delays and estimated travel duration with real-time updates.</p>
        </div>
        <div class="feature-card p-8 rounded-xl bg-gradient-to-br from-slate-800/50 to-slate-900/50 border border-slate-700/50 smooth-transition glow-hover hover:border-cyan-500/30 text-center">
            <div class="text-5xl mb-4 text-cyan-400 flex justify-center"><i class="fa-solid fa-check-circle"></i></div>
            <h3 class="text-2xl font-bold mb-3 text-white">Book or Track</h3>
            <p class="text-slate-400">Reserve a seat or track vehicles live on the map for peace of mind.</p>
        </div>
    </div>
</section>

<!-- Statistics (Live from DB) -->
<section class="stats py-20 px-8 bg-gradient-to-r from-slate-900/50 to-slate-800/50">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 max-w-6xl mx-auto">
        <div class="stat-box p-8 rounded-xl bg-gradient-to-br from-cyan-500/10 to-blue-500/10 border border-cyan-500/20 text-center smooth-transition hover:border-cyan-500/50">
            <h2 class="text-5xl font-bold text-cyan-400 mb-2">@Model.Stats.TotalRoutes</h2>
            <p class="text-slate-400">Active Routes</p>
        </div>
        <div class="stat-box p-8 rounded-xl bg-gradient-to-br from-cyan-500/10 to-blue-500/10 border border-cyan-500/20 text-center smooth-transition hover:border-cyan-500/50">
            <h2 class="text-5xl font-bold text-cyan-400 mb-2">@Model.Stats.TotalBookings</h2>
            <p class="text-slate-400">Bookings Made</p>
        </div>
        <div class="stat-box p-8 rounded-xl bg-gradient-to-br from-cyan-500/10 to-blue-500/10 border border-cyan-500/20 text-center smooth-transition hover:border-cyan-500/50">
            <h2 class="text-5xl font-bold text-cyan-400 mb-2">24/7</h2>
            <p class="text-slate-400">Live Updates</p>
        </div>
        <div class="stat-box p-8 rounded-xl bg-gradient-to-br from-cyan-500/10 to-blue-500/10 border border-cyan-500/20 text-center smooth-transition hover:border-cyan-500/50">
            <h2 class="text-5xl font-bold text-cyan-400 mb-2">PKR @(((int)Model.Stats.TotalRevenue).ToString("N0"))</h2>
            <p class="text-slate-400">Revenue Collected</p>
        </div>
    </div>
</section>

<!-- Routes -->
<section id="routes" class="routes py-20 px-8 max-w-7xl mx-auto">
    <div class="route-top flex flex-col md:flex-row justify-between items-center gap-6 mb-16">
        <h2 class="text-4xl font-bold text-white">Popular Routes</h2>
        <input type="text" id="searchInput"
               class="px-6 py-3 rounded-lg bg-slate-800/50 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500 smooth-transition w-full md:w-64"
               placeholder="Search routes..." />
    </div>

    <div id="routeContainer" class="route-container grid grid-cols-1 md:grid-cols-2 gap-8">
        @foreach (var route in Model.Routes)
        {
            <div class="route-card p-6 rounded-xl bg-gradient-to-br from-slate-800/50 to-slate-900/50 border border-slate-700/50 smooth-transition glow-hover hover:border-cyan-500/30 overflow-hidden"
                 data-route="@route.FullRoute">
                <img src="@route.ImageUrl" alt="@route.FullRoute"
                     class="w-full h-40 object-cover rounded-lg mb-4 smooth-transition" loading="lazy" />
                <div class="route-info space-y-3">
                    <h3 class="text-xl font-bold text-white">@route.FullRoute</h3>
                    <p class="text-slate-400"><strong>Vehicle:</strong> @route.VehicleType</p>
                    <p class="text-slate-400"><strong>Departure:</strong> @route.DepartureTime</p>
                    <p class="text-slate-400"><strong>Seats Available:</strong>
                        <span class="@(route.AvailableSeats < 5 ? "text-red-400" : "text-green-400") font-semibold">@route.AvailableSeats</span>
                    </p>

                    @if (route.IsOnTime)
                    {
                        <span class="inline-block px-3 py-1 rounded-full bg-green-500/20 text-green-300 text-sm font-semibold">✓ On Time</span>
                    }
                    else
                    {
                        <span class="inline-block px-3 py-1 rounded-full bg-red-500/20 text-red-300 text-sm font-semibold">⚠ Delayed @route.DelayInfo</span>
                    }

                    @if (route.AvailableSeats > 0)
                    {
                        <button class="book-btn w-full mt-4 px-4 py-2 bg-cyan-500 hover:bg-cyan-600 text-white font-semibold rounded-lg smooth-transition glow-hover cursor-pointer"
                                data-route-id="@route.Id"
                                data-route="@route.FullRoute"
                                data-price="@route.Price"
                                data-seats="@route.AvailableSeats">
                            Book Now – PKR @route.Price.ToString("N0")
                        </button>
                    }
                    else
                    {
                        <button class="w-full mt-4 px-4 py-2 bg-slate-600 text-slate-400 font-semibold rounded-lg cursor-not-allowed" disabled>
                            Sold Out
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</section>

<!-- Tracking -->
<section id="tracking" class="tracking py-20 px-8 bg-gradient-to-r from-slate-900/50 to-slate-800/50 max-w-7xl mx-auto rounded-xl">
    <div class="section-title text-center mb-16">
        <h2 class="text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">Live Tracking Dashboard</h2>
        <p class="text-xl text-slate-400">Monitor vehicles, routes, and arrival status on an interactive dashboard.</p>
    </div>

    <div class="tracking-grid grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="track-map-panel lg:col-span-1">
            <div id="trackingMap" class="track-map h-80 bg-gradient-to-br from-slate-800/50 to-slate-900 rounded-lg border border-slate-700 flex items-center justify-center relative overflow-hidden">
                <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center">
                        <div class="text-5xl mb-4 text-cyan-400"><i class="fa-solid fa-map"></i></div>
                        <div id="trackLiveNote" class="text-slate-400 text-sm">Click a route to track live</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="track-list lg:col-span-2 space-y-4">
            @foreach (var track in Model.TrackingList)
            {
                var isFirst = Model.TrackingList.IndexOf(track) == 0;
                var cardClass = isFirst
                    ? "track-card p-6 rounded-lg bg-gradient-to-r from-cyan-500/20 to-blue-500/20 border border-cyan-500/50 cursor-pointer smooth-transition hover:border-cyan-400 active-tracking"
                    : "track-card p-6 rounded-lg bg-slate-800/50 border border-slate-700/50 cursor-pointer smooth-transition hover:border-cyan-500/30";

                <div class="@cardClass"
                     data-route="@track.Route"
                     data-status="@track.Status"
                     data-progress="@track.ProgressPercent"
                     data-eta="@track.Eta">
                    <div class="flex justify-between items-start mb-3">
                        <div>
                            <h3 class="text-xl font-bold text-white">@track.Route</h3>
                            <p class="text-slate-400">@track.VehicleType • @track.DepartureTime</p>
                        </div>
                        @if (track.IsDelayed)
                        {
                            <span class="px-3 py-1 rounded-full bg-red-500/30 text-red-300 text-xs font-semibold">Delayed</span>
                        }
                        else
                        {
                            <span class="px-3 py-1 rounded-full bg-green-500/30 text-green-300 text-xs font-semibold">On Time</span>
                        }
                    </div>
                    <div class="track-progress w-full h-2 bg-slate-700 rounded-full overflow-hidden mb-2">
                        <div class="track-progress-fill h-full bg-gradient-to-r from-cyan-400 to-blue-400 rounded-full"
                             style="width:@(track.ProgressPercent)%; transition: width 0.5s ease;"></div>
                    </div>
                    <div class="flex justify-between text-sm text-slate-400">
                        <small>Progress: @track.ProgressPercent%</small>
                        <small>ETA: @track.Eta</small>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Booking Tracker -->
<section id="booking-tracker" class="py-20 px-8 max-w-3xl mx-auto">
    <div class="section-title text-center mb-12">
        <h2 class="text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">Track Your Booking</h2>
        <p class="text-xl text-slate-400">Enter your booking reference to view or manage your ticket.</p>
    </div>

    <div class="p-8 rounded-xl bg-gradient-to-br from-slate-800/50 to-slate-900/50 border border-slate-700/50">
        <div class="flex gap-4 mb-6">
            <input type="text" id="bookingRefInput" placeholder="Enter booking reference (e.g. A1B2C3D4)"
                   class="flex-1 px-6 py-3 rounded-lg bg-slate-700/50 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500 smooth-transition uppercase" />
            <button id="trackBookingBtn" class="px-6 py-3 bg-cyan-500 hover:bg-cyan-600 text-white font-semibold rounded-lg smooth-transition">
                <i class="fa-solid fa-search mr-2"></i>Track
            </button>
        </div>

        <div id="bookingResult" class="hidden"></div>
    </div>
</section>

<!-- Contact -->
<section id="contact" class="contact py-20 px-8 max-w-4xl mx-auto">
    <div class="section-title text-center mb-16">
        <h2 class="text-5xl font-bold mb-4 bg-gradient-to-r from-cyan-400 to-blue-400 bg-clip-text text-transparent">Contact Us</h2>
        <p class="text-xl text-slate-400">Send your feedback or suggestions.</p>
    </div>

    @if (TempData["ContactSuccess"] != null)
    {
        <div class="mb-6 p-4 rounded-lg bg-green-500/20 border border-green-500/30 text-green-300 text-center">
            <i class="fa-solid fa-check-circle mr-2"></i>@TempData["ContactSuccess"]
        </div>
    }

    <form asp-action="Contact" asp-controller="Home" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <div>
            <input asp-for="ContactForm.Name" placeholder="Your Name"
                   class="w-full px-6 py-3 rounded-lg bg-slate-800/50 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500 smooth-transition" />
            <span asp-validation-for="ContactForm.Name" class="text-red-400 text-sm mt-1 block"></span>
        </div>
        <div>
            <input asp-for="ContactForm.Email" placeholder="Your Email"
                   class="w-full px-6 py-3 rounded-lg bg-slate-800/50 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500 smooth-transition" />
            <span asp-validation-for="ContactForm.Email" class="text-red-400 text-sm mt-1 block"></span>
        </div>
        <div>
            <textarea asp-for="ContactForm.Message" rows="6" placeholder="Your Message"
                      class="w-full px-6 py-3 rounded-lg bg-slate-800/50 border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500 smooth-transition resize-none"></textarea>
            <span asp-validation-for="ContactForm.Message" class="text-red-400 text-sm mt-1 block"></span>
        </div>
        <button type="submit" class="w-full px-6 py-3 bg-cyan-500 hover:bg-cyan-600 text-white font-semibold rounded-lg smooth-transition glow-hover cursor-pointer">
            <i class="fa-solid fa-paper-plane mr-2"></i>Send Message
        </button>
    </form>
</section>

<!-- Booking Modal -->
<div id="bookingModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm">
    <div class="booking-modal bg-slate-900 border border-cyan-500/30 rounded-2xl p-8 max-w-lg w-full mx-4 shadow-2xl relative">
        <button id="closeModal" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl transition-colors">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <h2 class="text-2xl font-bold text-white mb-2">Book Your Ticket</h2>
        <p id="modalRouteName" class="text-cyan-400 mb-6 font-semibold"></p>

        <div class="space-y-4" id="bookingFormFields">
            <div>
                <label class="block text-slate-400 text-sm mb-1">Passenger Name</label>
                <input type="text" id="passengerName" placeholder="Full name"
                       class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500 smooth-transition" />
            </div>
            <div>
                <label class="block text-slate-400 text-sm mb-1">Email Address</label>
                <input type="email" id="passengerEmail" placeholder="your@email.com"
                       class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-600 text-white placeholder-slate-400 focus:outline-none focus:border-cyan-500 smooth-transition" />
            </div>
            <div>
                <label class="block text-slate-400 text-sm mb-1">Number of Seats</label>
                <select id="seatCount"
                        class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-600 text-white focus:outline-none focus:border-cyan-500 smooth-transition">
                    <option value="1">1 Seat</option>
                    <option value="2">2 Seats</option>
                    <option value="3">3 Seats</option>
                    <option value="4">4 Seats</option>
                    <option value="5">5 Seats</option>
                </select>
            </div>

            <div class="p-4 rounded-lg bg-slate-800/50 border border-slate-700">
                <div class="flex justify-between text-slate-400 text-sm mb-1">
                    <span>Price per seat</span>
                    <span id="pricePerSeat">PKR 0</span>
                </div>
                <div class="flex justify-between text-white font-bold text-lg">
                    <span>Total</span>
                    <span id="totalPriceDisplay" class="text-cyan-400">PKR 0</span>
                </div>
            </div>
        </div>

        <div id="bookingError" class="hidden mt-4 p-3 rounded-lg bg-red-500/20 border border-red-500/30 text-red-300 text-sm"></div>

        <button id="confirmBookingBtn"
                class="w-full mt-6 px-6 py-3 bg-cyan-500 hover:bg-cyan-600 text-white font-bold rounded-lg smooth-transition glow-hover">
            <i class="fa-solid fa-check mr-2"></i>Confirm Booking
        </button>
    </div>
</div>

<!-- Booking Success Modal -->
<div id="successModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 backdrop-blur-sm">
    <div class="bg-slate-900 border border-green-500/30 rounded-2xl p-8 max-w-md w-full mx-4 text-center shadow-2xl">
        <div class="text-6xl text-green-400 mb-4"><i class="fa-solid fa-circle-check"></i></div>
        <h2 class="text-2xl font-bold text-white mb-2">Booking Confirmed!</h2>
        <p id="successMessage" class="text-slate-300 mb-4"></p>
        <div class="p-4 rounded-lg bg-slate-800 mb-6">
            <p class="text-slate-400 text-sm mb-1">Your Booking Reference</p>
            <p id="bookingRefDisplay" class="text-3xl font-bold text-cyan-400 tracking-widest"></p>
        </div>
        <p class="text-slate-400 text-sm mb-6">Save this reference to track or manage your booking.</p>
        <button id="closeSuccessModal" class="px-8 py-3 bg-cyan-500 hover:bg-cyan-600 text-white font-semibold rounded-lg smooth-transition">
            Done
        </button>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
