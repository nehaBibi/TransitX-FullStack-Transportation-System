<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – TransitX Smart Transportation</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar fixed w-full top-0 left-0 px-8 py-5 flex justify-between items-center bg-black/50 backdrop-blur-lg z-[1000] border-b border-slate-700/50 smooth-transition">
        <a asp-controller="Home" asp-action="Index"
           class="logo flex items-center gap-2 text-3xl font-bold text-cyan-400">
            <i class="fa-solid fa-bus"></i>TransitX
        </a>
        <ul class="nav-links hidden md:flex list-none gap-8 justify-center flex-1 mx-auto">
            <li><a href="#home"    class="hover:text-cyan-400 smooth-transition">Home</a></li>
            <li><a href="#routes"  class="hover:text-cyan-400 smooth-transition">Routes</a></li>
            <li><a href="#tracking" class="hover:text-cyan-400 smooth-transition">Tracking</a></li>
            <li><a href="#contact" class="hover:text-cyan-400 smooth-transition">Contact</a></li>
        </ul>
        <button class="menu-btn md:hidden text-2xl cursor-pointer hover:text-cyan-400 smooth-transition"
                id="mobileMenuBtn" aria-label="Toggle menu">
            <i class="fa-solid fa-bars"></i>
        </button>
    </nav>

    @RenderBody()

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-12 px-8 text-center">
        <h2 class="text-3xl font-bold text-cyan-400 mb-2">
            <i class="fa-solid fa-bus mr-2"></i>TransitX
        </h2>
        <p class="text-slate-400">© @DateTime.Now.Year Smart Transportation Platform. All rights reserved.</p>
        <div class="flex justify-center gap-4 mt-6">
            <a href="#" class="text-slate-400 hover:text-cyan-400 smooth-transition"><i class="fab fa-facebook fa-lg"></i></a>
            <a href="#" class="text-slate-400 hover:text-cyan-400 smooth-transition"><i class="fab fa-twitter fa-lg"></i></a>
            <a href="#" class="text-slate-400 hover:text-cyan-400 smooth-transition"><i class="fab fa-instagram fa-lg"></i></a>
            <a href="#" class="text-slate-400 hover:text-cyan-400 smooth-transition"><i class="fab fa-linkedin fa-lg"></i></a>
        </div>
    </footer>

    <!-- Booking Modal -->
    <div id="bookingModal"
         class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center hidden smooth-transition"
         role="dialog" aria-modal="true" aria-labelledby="bookingModalTitle">
        <div class="modal-content bg-slate-800 rounded-xl p-8 max-w-md w-full mx-4 border border-slate-700 smooth-transition">
            <div class="flex justify-between items-center mb-6">
                <h2 id="bookingModalTitle" class="text-2xl font-bold text-white">Book Your Ticket</h2>
                <button class="close-modal text-slate-400 hover:text-white text-2xl cursor-pointer" aria-label="Close">✕</button>
            </div>
            <div class="space-y-4 mb-6 text-slate-300">
                <p><strong>Route:</strong> <span id="modalRoute"></span></p>
                <p><strong>Price:</strong> <span id="modalPrice" class="text-cyan-400 font-bold"></span></p>
                <p class="text-sm text-slate-400">Select number of seats:</p>
                <div class="flex gap-2">
                    <button type="button" class="seat-btn flex-1 px-4 py-2 bg-slate-700 hover:bg-cyan-500 text-white rounded-lg smooth-transition cursor-pointer" data-seats="1">1 Seat</button>
                    <button type="button" class="seat-btn flex-1 px-4 py-2 bg-slate-700 hover:bg-cyan-500 text-white rounded-lg smooth-transition cursor-pointer" data-seats="2">2 Seats</button>
                    <button type="button" class="seat-btn flex-1 px-4 py-2 bg-slate-700 hover:bg-cyan-500 text-white rounded-lg smooth-transition cursor-pointer" data-seats="4">4 Seats</button>
                </div>
            </div>
            <button id="confirmBooking"
                    class="w-full px-4 py-3 bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-600 hover:to-blue-600 text-white font-bold rounded-lg smooth-transition cursor-pointer">
                Confirm Booking
            </button>
            <p class="text-center text-slate-400 text-xs mt-4">Payment will be processed securely</p>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmationModal"
         class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center hidden smooth-transition"
         role="dialog" aria-modal="true">
        <div class="modal-content bg-slate-800 rounded-xl p-8 max-w-md w-full mx-4 border border-slate-700 text-center smooth-transition">
            <div class="text-5xl mb-4 text-green-400"><i class="fa-solid fa-check-circle"></i></div>
            <h2 class="text-2xl font-bold text-white mb-2">Booking Confirmed!</h2>
            <p class="text-slate-400 mb-2" id="confirmMsg">Your ticket has been booked successfully.</p>
            <p class="text-cyan-400 font-bold mb-6" id="confirmRef"></p>
            <p class="text-sm text-slate-500 mb-6">Confirmation details have been sent to your email.</p>
            <button class="close-modal w-full px-4 py-3 bg-cyan-500 hover:bg-cyan-600 text-white font-semibold rounded-lg smooth-transition cursor-pointer">OK</button>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
